# Copy to .env.local and fill in. Web config values are not secrets, but .env.local is gitignored anyway.
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check is required by Firebase AI Logic.
# Production: reCAPTCHA v3 site key registered in Firebase console → App Check.
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
# "v3" (default) for a reCAPTCHA v3 key, or "enterprise" for a reCAPTCHA Enterprise key.
VITE_APPCHECK_PROVIDER=v3
# Local development / judging: "true" prints a debug token to the browser console on first run
# (register it in Firebase console → App Check → Manage debug tokens), or paste an existing token.
VITE_APPCHECK_DEBUG_TOKEN=

# Cloud model used for the heavy "explain" step. Check the Firebase AI Logic models page for current names.
VITE_CLOUD_MODEL=gemini-3.5-flash
# Cloud fallback for light tasks that prefer on-device.
VITE_CLOUD_MODEL_LITE=gemini-3.5-flash-lite
